# --- Server ---
PORT=4000
BASE_URL=http://localhost:4000
APP_TIMEZONE=Asia/Kolkata
JWT_SECRET=change-this-to-a-long-random-string
CREDENTIAL_ENCRYPTION_KEY=change-this-to-a-32-byte-hex-key-generate-with-crypto-randomBytes

# --- Database driver ---
# DB_DRIVER=mysql for production. DB_DRIVER=sqlite for zero-config local testing
# (no MySQL server required - used automatically if MySQL is not yet available).
DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=techforce
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=techforce_outreach

# --- Legal / compliance footer (CAN-SPAM & GDPR required info) ---
COMPANY_NAME=Techforce Global
COMPANY_POSTAL_ADDRESS=Your Registered Office Address, City, State, ZIP, Country

# --- Sending guardrails (global defaults, overridable per mailbox/campaign) ---
DEFAULT_DAILY_CAP=30
WARMUP_START_CAP=5
WARMUP_RAMP_DAYS=21
MIN_HOURS_BETWEEN_EMAILS_TO_SAME_PROSPECT=72
SEND_WINDOW_START_HOUR=9
SEND_WINDOW_END_HOUR=18
SEND_ONLY_WEEKDAYS=true
MIN_SECONDS_BETWEEN_SENDS=45
MAX_SECONDS_BETWEEN_SENDS=180
AUTO_PAUSE_BOUNCE_RATE_PERCENT=5
AUTO_PAUSE_COMPLAINT_RATE_PERCENT=0.3

# --- Testing ---
# When true, the mailer uses Nodemailer's jsonTransport (no real network send) -
# used for automated smoke tests only. Always false in production.
TEST_MODE=false
